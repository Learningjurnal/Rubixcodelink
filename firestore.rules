rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Single user isolated workspace: only the signed-in owner (including
    // anonymous-auth sessions) may read/write their own subtree.
    // Anything outside /users/{userId}/** is denied by default.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
