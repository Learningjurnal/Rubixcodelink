# GEMINI_API_KEY: Required for Gemini AI API calls.
# Users configure this via environment variables or secret settings.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Supabase Configuration
# Project Settings > API in your Supabase dashboard. The anon key is safe
# to expose to the browser — it only grants what the RLS policies in
# supabase/migrations/0001_init.sql allow (a signed-in user's own rows).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
